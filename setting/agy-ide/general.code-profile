    "keybindings": "{\"keybindings\":\"// 既定値を上書きするには、このファイル内にキー バインドを挿入します\\n[\\n    {\\n        \\\"key\\\": \\\"cmd+l\\\",\\n        \\\"command\\\": \\\"-antigravity.toggleChatFocus\\\",\\n        \\\"when\\\": \\\"!terminalFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+.\\\",\\n        \\\"command\\\": \\\"workbench.action.openSettings\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+t\\\",\\n        \\\"command\\\": \\\"workbench.action.focusPanel\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+l\\\",\\n        \\\"command\\\": \\\"-antigravity.startNewConversation\\\"\\n    }\\n]\\n\",\"platform\":1}",
    "name": "general",
    "settings": "{\"settings\":\"{\\n    \\\"editor.quickSuggestions\\\": {\\n        \\\"strings\\\": \\\"on\\\"\\n    },\\n    \\\"editor.fontFamily\\\": \\\"'SauceCodePro Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace\\\",\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.renderWhitespace\\\": \\\"boundary\\\",\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\n    \\\"files.associations\\\": {\\n        \\\"*.css\\\": \\\"tailwindcss\\\"\\n    },\\n    \\\"files.insertFinalNewline\\\": true,\\n    \\\"files.trimFinalNewlines\\\": true,\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"terminal.integrated.lineHeight\\\": 1.4,\\n    \\\"window.zoomLevel\\\": 1,\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"workbench.editor.pinnedTabsOnSeparateRow\\\": true,\\n    \\\"workbench.editor.tabSizing\\\": \\\"shrink\\\",\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"workbench.tree.indent\\\": 28,\\n    \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n    \\\"workbench.editor.closeEmptyGroups\\\": false,\\n    \\\"diffEditor.renderSideBySide\\\": true,\\n    \\\"window.title\\\": \\\"${rootName}${separator}${activeRepositoryBranchName}\\\",\\n    \\\"terminal.integrated.scrollback\\\": 10000,\\n    \\\"terminal.integrated.stickyScroll.enabled\\\": false\\n}\\n\"}"
}
